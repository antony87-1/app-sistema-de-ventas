{
  "name": "kankachos-valeriano",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "test:sqlite": "vitest run --config vitest.sqlite.config.ts",
    "test:all": "npm run test:ci && npm run test:sqlite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cap:sync": "cap sync",
    "android:sync": "npm run build && cap sync android",
    "android:build:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10.9.0 <11"
  },
  "dependencies": {
    "@angular/common": "21.2.18",
    "@angular/compiler": "21.2.18",
    "@angular/core": "21.2.18",
    "@angular/forms": "21.2.18",
    "@angular/platform-browser": "21.2.18",
    "@angular/router": "21.2.18",
    "@capacitor-community/sqlite": "8.1.0",
    "@capacitor/android": "8.4.2",
    "@capacitor/core": "8.4.2",
    "@ionic/angular": "8.8.15",
    "hash-wasm": "4.12.0",
    "ionicons": "8.1.0",
    "jeep-sqlite": "2.8.0",
    "rxjs": "7.8.2",
    "sql.js": "1.11.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.18",
    "@angular/cli": "21.2.18",
    "@angular/compiler-cli": "21.2.18",
    "@capacitor/cli": "8.4.2",
    "jsdom": "28.1.0",
    "prettier": "3.8.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
